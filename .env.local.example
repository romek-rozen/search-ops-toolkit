# .env.local — dev server (npm run dev) running outside Docker
# Dev server connects to PostgreSQL via localhost, not Docker DNS (db:5471)
# Copy this file to .env.local and fill in the values

DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5471/search_ops?schema=public"
POSTGRES_PASSWORD="YOUR_PASSWORD"
SESSION_SECRET="YOUR_SESSION_SECRET"
ADMIN_EMAIL="your@email.com"
NEXT_PUBLIC_ADMIN_EMAIL="your@email.com"

# Dev server port (different from prod)
PORT=3848

# Postback URL for DataForSEO callbacks (dev: https://dev.sot.nimblio.work)
CALLBACK_BASE_URL=""
